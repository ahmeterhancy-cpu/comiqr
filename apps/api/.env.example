APP_NAME=ComiQR
APP_ENV=local
APP_KEY=
# Local'de true yapabilirsin; PROD'da MUTLAKA false (stack-trace + config sızıntısı).
APP_DEBUG=false
APP_URL=http://localhost:8000
APP_TIMEZONE=Asia/Nicosia
# CORS: prod'da bilinen frontend origin'leri (virgülle ayır); boş bırakılırsa '*' (bearer-token ile güvenli).
CORS_ALLOWED_ORIGINS=
# Hata izleme (A5): Sentry projesinin DSN'i — boşsa devre dışı.
SENTRY_LARAVEL_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1

# Tenant resolution: {tenant}.comiqr.local in dev. Central (non-tenant) hosts below.
APP_BASE_DOMAIN=comiqr.local
CENTRAL_DOMAINS=localhost,127.0.0.1,api.comiqr.local,admin.comiqr.local

APP_LOCALE=tr
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=tr_TR

APP_MAINTENANCE_DRIVER=file
PHP_CLI_SERVER_WORKERS=4
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# --- Database: PostgreSQL (dev: local docker; prod: Neon Frankfurt pooled) ---
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=comiqr
DB_USERNAME=comiqr
DB_PASSWORD=comiqr

# --- Session / cache / queue on Redis ---
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

CACHE_STORE=redis
QUEUE_CONNECTION=redis

# --- Redis (dev: local docker; prod: Upstash). predis client (no phpredis ext). ---
REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# --- Broadcasting: Laravel Reverb (WebSocket) ---
# Prod (queue worker'lı): reverb. Yerelde QUEUE_CONNECTION=sync olduğu için yayın
# inline çalışır — Reverb kapalıyken siparişin 500 vermemesi için yerelde 'log'
# kullanın; canlı WS isterken reverb'e çevirip `php artisan reverb:start` çalıştırın.
BROADCAST_CONNECTION=reverb
REVERB_APP_ID=comiqr
REVERB_APP_KEY=local-reverb-key
REVERB_APP_SECRET=local-reverb-secret
REVERB_HOST=127.0.0.1
REVERB_PORT=8080
REVERB_SCHEME=http
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8080

# --- Mail (dev: log; prod: Brevo SMTP/API) ---
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@comiqr.com"
MAIL_FROM_NAME="${APP_NAME}"
BREVO_API_KEY=

# --- Filesystem: Cloudflare R2 (S3-compatible) ---
FILESYSTEM_DISK=local
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=comiqr-media
R2_ENDPOINT=
R2_URL=

# --- Sanctum / SPA ---
SANCTUM_STATEFUL_DOMAINS=localhost,localhost:3000,localhost:3001,localhost:3002,127.0.0.1
FRONTEND_URL=http://localhost:3001

# --- Payments (tiko) ---
PAYMENT_DEFAULT_GATEWAY=cash
# Tiko (tikokart.com) Virtual POS
TIKO_MERCHANT_ID=
TIKO_SECRET=
TIKO_PASSWORD=
TIKO_BASE_URL=https://www.tikokart.com/api-sanalpos
TIKO_IS_TEST=true
TIKO_CURRENCY=TRY
TIKO_URL_OK=
TIKO_URL_FAIL=

# --- Messaging ---
TELSIM_SMS_URL=
TELSIM_SMS_USER=
TELSIM_SMS_PASS=
TELSIM_SMS_HEADER=
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
FCM_SERVER_KEY=

# --- AI (metin: chatbot, açıklama, çeviri, danışman) ---
# Varsayılan sağlayıcı DeepSeek (OpenAI-uyumlu). 'anthropic' de seçilebilir.
AI_PROVIDER=deepseek
DEEPSEEK_API_KEY=
# deepseek-v4-flash (ucuz/yüksek hacim) | deepseek-v4-pro (güçlü)
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MAX_TOKENS=1024
# Görsel (yalnız fotoğraftan menü import) — DeepSeek metin-only, vision için Anthropic.
# ANTHROPIC_API_KEY boşsa import 503 (metin AI DeepSeek ile çalışmaya devam eder).
AI_VISION_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
HIGGSFIELD_API_KEY=
ELEVENLABS_API_KEY=
