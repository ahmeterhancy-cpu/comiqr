# ============================================================================
# ComiQR — root environment example (monorepo-wide).
# Copy to .env and fill. Per-app env lives in apps/<app>/.env.example too.
# ComiQR is a working codename; brand name is injected via APP_NAME (never hardcode).
# ============================================================================

# --- Brand / naming (single source of truth for rebrand) ---
APP_NAME="ComiQR"

# --- Public URLs (dev defaults) ---
# Base domain for tenant subdomains: {tenant}.comiqr.local in dev
APP_BASE_DOMAIN=comiqr.local
API_URL=http://localhost:8000
API_URL_V1=http://localhost:8000/v1

# --- Next.js public vars (exposed to browser) ---
NEXT_PUBLIC_APP_NAME="ComiQR"
NEXT_PUBLIC_API_URL=http://localhost:8000/v1
NEXT_PUBLIC_DEFAULT_LOCALE=tr

# --- PostgreSQL (dev: local docker; prod: Neon Frankfurt, pgBouncer pooled) ---
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=comiqr
DB_USERNAME=comiqr
DB_PASSWORD=comiqr
# Prod example (Neon pooled):
# DATABASE_URL=postgres://user:pass@ep-xxx-pooler.eu-central-1.aws.neon.tech/comiqr?sslmode=require

# --- Redis (dev: local docker; prod: Upstash) ---
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=null
# Prod example (Upstash):
# REDIS_URL=rediss://default:xxx@eu1-xxx.upstash.io:6379

# --- Cloudflare R2 (S3-compatible media) ---
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=comiqr-media
R2_ENDPOINT=
R2_PUBLIC_URL=

# --- Laravel Reverb (realtime WS) ---
REVERB_APP_ID=comiqr
REVERB_APP_KEY=local-reverb-key
REVERB_APP_SECRET=local-reverb-secret
REVERB_HOST=127.0.0.1
REVERB_PORT=8080
REVERB_SCHEME=http

# --- Payments (abstract PaymentGateway: tiko | paytr) ---
PAYMENT_DEFAULT_GATEWAY=paytr
PAYTR_MERCHANT_ID=
PAYTR_MERCHANT_KEY=
PAYTR_MERCHANT_SALT=
TIKO_API_KEY=
TIKO_API_SECRET=

# --- Messaging ---
BREVO_API_KEY=
TELSIM_SMS_USER=
TELSIM_SMS_PASS=
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
FCM_SERVER_KEY=

# --- AI ---
ANTHROPIC_API_KEY=
HIGGSFIELD_API_KEY=
ELEVENLABS_API_KEY=
